# Scalar subset: derived values, locals, conditional, require and Unicode.
app "Rust scalar parity"
state counter = 0
state enabled = true
state title = "Guest"
persist title
derive positive = counter > 0
derive guest = title == "Guest"
action add:
    let next = counter + 1
    if enabled:
        counter = next
    else:
        counter = counter - 1
action toggle:
    enabled = not enabled
action rename:
    require enabled
    title = "Алиса 😀"
action reset:
    counter = 0
    enabled = true
    title = "Guest"
rule counter >= 0 and counter <= 10
test initial: -> counter == 0 and guest and not positive
test increment: add, add -> counter == 2 and positive
test unicode: rename -> title == "Алиса 😀"
screen main:
    text "Native core conformance"
    value counter
    value title
    input title
    show positive : text "Positive"
    button "Add" -> add
