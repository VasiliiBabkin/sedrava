application "Сервисный справочник"
access session read write

entity client "Заказчики":
    name: text 1 128 label "Название"
    contact: text 0 128 label "Контакт"

entity site "Объекты":
    client: ref client label "Заказчик"
    name: text 1 128 label "Название"
    address: text 1 256 label "Адрес"

entity asset "Оборудование":
    site: ref site label "Объект"
    name: text 1 128 label "Модель"
    serial: text 0 128 label "Серийный номер"

entity ticket "Заявки":
    asset: ref asset label "Оборудование"
    issue: text 1 256 label "Неисправность"
    priority: int 1 3 label "Приоритет"

workflow ticket:
    initial open
    transition work "Записать работу" from open to open
    transition close "Закрыть" from open to closed
    transition reopen "Открыть повторно" from closed to open
