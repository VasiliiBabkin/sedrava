app "Namespaced bounded core"
import "model.sdr" as model
state ready = true
screen main:
    value model.total
    value model.label
    value model.code
    value model.size
    button "scan" -> model.scan
    button "add" -> model.add
    button "expected" -> model.expected
    button "seed" -> model.seed
    button "audit" -> model.audit
    button "reject" -> model.reject
    button "scalars" -> model.scalars
    button "break_rule" -> model.break_rule
test snapshot: model.scan -> model.total == 6
test expected: model.expected -> model.total == 42 and model.code == "INT_OVERFLOW"
