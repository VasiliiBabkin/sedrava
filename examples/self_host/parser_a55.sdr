# A5.4 Sedrava-authored bounded stack-based arithmetic parser.
# Arithmetic integer expressions with grouping and binary precedence.
# Precedence: * / before + -, left associative for equal precedence.
# One ASCII identifier assignment per active line, arbitrary consistent
# 4-space indent/dedent levels. This is NOT full Sedrava grammar.
# One action scans up to 256 Unicode scalars. Strings preserve raw spelling.
# Supports ASCII identifiers/integers, quoted strings and basic escapes,
# whitespace, # comments, punctuation and two-character operators.
app "Self-host Parser A5.5"
record Token:
    kind: text
    lexeme: text
    offset: int
    end: int
    line: int
    column: int
record Assignment:
    name: text
    literal: text
    start: int
    end: int
record LayoutToken:
    kind: text
    offset: int
    line: int
    column: int
    level: int
record ExprNode:
    kind: text
    lexeme: text
    operator: text
    left_id: int
    right_id: int
    start: int
    end: int
record ExpressionAssignment:
    name: text
    expression_id: int
    start: int
    end: int

record UnifiedToken:
    kind: text
    lexeme: text
    offset: int
    end: int
    line: int
    column: int
    level: int
record ProgramAssignment:
    name: text
    literal: text
    depth: int
    line: int
    start: int
    end: int
record ProgramExpression:
    name: text
    expression_id: int
    depth: int
    line: int
    start: int
    end: int

record StackValue:
    node_id: int
    previous: int
record StackOperator:
    symbol: text
    priority: int
    offset: int
    previous: int

record BlockHeader:
    kind: text
    subject: text
    depth: int
    line: int
    start: int
    end: int
record SyntaxDiagnostic:
    code: text
    line: int
    column: int
    start: int
    end: int

fn comparison(op: text) -> bool = op == "==" or op == "!=" or op == "<" or op == "<=" or op == ">" or op == ">="
fn binary_op(op: text) -> bool = op == "or" or op == "and" or comparison(op) or op == "+" or op == "-" or op == "*" or op == "/"
fn atom_name(op: text) -> bool = op != "and" and op != "or" and op != "not" and op != "if" and op != "else" and op != "action" and op != "while" and op != "let" and op != "require"
fn op_rank(op: text) -> int = 1 if op == "or" else 2 if op == "and" else 3 if op == "not" else 4 if comparison(op) else 5 if op == "+" or op == "-" else 6 if op == "*" or op == "/" else 7

fn ascii_letter(ch: text) -> bool = contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_", ch)
fn ascii_digit(ch: text) -> bool = contains("0123456789", ch)

state source = "sum==42 # comment"
state cursor = 0
state start = 0
state line = 1
state column = 1
state start_line = 1
state start_column = 1
state fragment = ""
state fragment_kind = ""
state operator = ""
state in_string = false
state escaped = false
state in_comment = false
state tokens: list<Token>(max=100) = []
state assignments: list<Assignment>(max=1) = []

state layout_cursor = 0
state layout_line = 1
state layout_column = 1
state layout_spaces = 0
state layout_level = 0
state layout_desired = 0
state layout_at_start = true
state layout_active = false
state layout_comment = false
state layout_tokens: list<LayoutToken>(max=100) = []
state expressions: list<ExprNode>(max=16) = []
state expression_assignments: list<ExpressionAssignment>(max=1) = []


state merge_i = 1
state merge_j = 1
state unified_tokens: list<UnifiedToken>(max=100) = []

state parse_cursor = 1
state parse_depth = 0
state program_assignments: list<ProgramAssignment>(max=32) = []
state program_expr_cursor = 1
state program_expr_depth = 0
state program_expr_nodes: list<ExprNode>(max=100) = []
state program_expr_statements: list<ProgramExpression>(max=16) = []


state value_stack: list<StackValue>(max=100) = []
state operator_stack: list<StackOperator>(max=100) = []
state value_top = 0
state operator_top = 0
state value_count = 0
state expecting_value = true
state reducing = false
state finished = false
state last_end = 0
state precedence = 0


state headers: list<BlockHeader>(max=16) = []
state diagnostics: list<SyntaxDiagnostic>(max=1) = []
state validation_done = false
state validate_i = 1
state validate_depth = 0
state pending_body = false
state validate_error = ""
state expr_parens = 0
state validate_operand = true
state allow_not = true
state compare_depth: list<StackOperator>(max=100) = []
state compare_top = 0
state comparison_seen = false
state line_end = false
state validated_assignments = 0

action scan:
    require text_length(source) <= 256
    while cursor < text_length(source) limit 256:
        let ch = text_at(source, cursor)
        if in_comment:
            if ch == "\n":
                in_comment = false
        else:
            if in_string:
                fragment = concat(fragment, ch)
                if escaped:
                    require contains("ntr\"\\", ch)
                    escaped = false
                else:
                    if ch == "\\":
                        escaped = true
                    else:
                        if ch == "\"":
                            tokens = append(tokens, Token(kind="string", lexeme=fragment, offset=start, end=cursor + 1, line=start_line, column=start_column))
                            fragment = ""
                            fragment_kind = ""
                            in_string = false
            else:
                if ch == "#":
                    if fragment != "":
                        tokens = append(tokens, Token(kind=fragment_kind, lexeme=fragment, offset=start, end=cursor, line=start_line, column=start_column))
                        fragment = ""
                        fragment_kind = ""
                    in_comment = true
                else:
                    if ch == "\"":
                        if fragment != "":
                            tokens = append(tokens, Token(kind=fragment_kind, lexeme=fragment, offset=start, end=cursor, line=start_line, column=start_column))
                            fragment = ""
                            fragment_kind = ""
                        start = cursor
                        start_line = line
                        start_column = column
                        fragment = ch
                        fragment_kind = "string"
                        in_string = true
                    else:
                        if contains(" \t\r\n", ch):
                            if fragment != "":
                                tokens = append(tokens, Token(kind=fragment_kind, lexeme=fragment, offset=start, end=cursor, line=start_line, column=start_column))
                                fragment = ""
                                fragment_kind = ""
                        else:
                            if contains("(){}[],:.+-*/=<>!", ch):
                                if fragment != "":
                                    tokens = append(tokens, Token(kind=fragment_kind, lexeme=fragment, offset=start, end=cursor, line=start_line, column=start_column))
                                    fragment = ""
                                    fragment_kind = ""
                                operator = ch
                                if cursor + 1 < text_length(source):
                                    let next_ch = text_at(source, cursor + 1)
                                    if next_ch == "=" and contains("=!<>", ch):
                                        operator = concat(ch, next_ch)
                                        cursor = cursor + 1
                                    else:
                                        if ch == "-" and next_ch == ">":
                                            operator = "->"
                                            cursor = cursor + 1
                                if contains("+-*/=<>!", ch):
                                    tokens = append(tokens, Token(kind="operator", lexeme=operator, offset=cursor + 1 - text_length(operator), end=cursor + 1, line=line, column=column))
                                else:
                                    tokens = append(tokens, Token(kind="punct", lexeme=operator, offset=cursor + 1 - text_length(operator), end=cursor + 1, line=line, column=column))
                                if text_length(operator) == 2:
                                    column = column + 1
                            else:
                                require ascii_letter(ch) or ascii_digit(ch)
                                if fragment == "":
                                    start = cursor
                                    start_line = line
                                    start_column = column
                                    if ascii_digit(ch):
                                        fragment_kind = "integer"
                                    else:
                                        fragment_kind = "identifier"
                                else:
                                    if fragment_kind == "integer":
                                        require ascii_digit(ch)
                                fragment = concat(fragment, ch)
        if ch == "\n":
            line = line + 1
            column = 1
        else:
            column = column + 1
        cursor = cursor + 1
    require not in_string
    require not escaped
    if fragment != "":
        tokens = append(tokens, Token(kind=fragment_kind, lexeme=fragment, offset=start, end=cursor, line=start_line, column=start_column))
        fragment = ""
        fragment_kind = ""
action parse_assignment:
    require count(tokens) == 3
    let left = get(tokens, 1)
    let equal_sign = get(tokens, 2)
    let right = get(tokens, 3)
    require left.kind == "identifier"
    require equal_sign.kind == "operator" and equal_sign.lexeme == "="
    require right.kind == "integer"
    assignments = append(assignments, Assignment(name=left.lexeme, literal=right.lexeme, start=left.offset, end=right.end))

action scan_layout:
    require text_length(source) <= 256
    while layout_cursor < text_length(source) limit 256:
        let ch = text_at(source, layout_cursor)
        if ch == "\n":
            if layout_active:
                layout_tokens = append(layout_tokens, LayoutToken(kind="NEWLINE", offset=layout_cursor, line=layout_line, column=layout_column, level=layout_level))
            layout_active = false
            layout_comment = false
            layout_at_start = true
            layout_spaces = 0
            layout_line = layout_line + 1
            layout_column = 1
        else:
            if layout_comment:
                require ch != "\r"
            else:
                if layout_at_start:
                    if ch == " ":
                        layout_spaces = layout_spaces + 1
                    else:
                        if ch == "#":
                            layout_comment = true
                        else:
                            require ch != "\t" and ch != "\r" and ch != "\""
                            require layout_spaces <= 32
                            layout_desired = 0
                            while layout_spaces > 0 limit 8:
                                require layout_spaces >= 4
                                layout_spaces = layout_spaces - 4
                                layout_desired = layout_desired + 1
                            while layout_level < layout_desired limit 8:
                                layout_level = layout_level + 1
                                layout_tokens = append(layout_tokens, LayoutToken(kind="INDENT", offset=layout_cursor, line=layout_line, column=layout_column, level=layout_level))
                            while layout_level > layout_desired limit 8:
                                layout_level = layout_level - 1
                                layout_tokens = append(layout_tokens, LayoutToken(kind="DEDENT", offset=layout_cursor, line=layout_line, column=layout_column, level=layout_level))
                            layout_at_start = false
                            layout_active = true
                else:
                    if ch == "#":
                        layout_comment = true
                    else:
                        require ch != "\t" and ch != "\r" and ch != "\""
            layout_column = layout_column + 1
        layout_cursor = layout_cursor + 1
    if layout_active:
        layout_tokens = append(layout_tokens, LayoutToken(kind="NEWLINE", offset=layout_cursor, line=layout_line, column=layout_column, level=layout_level))
    while layout_level > 0 limit 8:
        layout_level = layout_level - 1
        layout_tokens = append(layout_tokens, LayoutToken(kind="DEDENT", offset=layout_cursor, line=layout_line, column=layout_column, level=layout_level))

action parse_binary:
    require count(tokens) == 5 or count(tokens) == 7
    let variable = get(tokens, 1)
    let equal_sign = get(tokens, 2)
    let first = get(tokens, 3)
    let first_operator = get(tokens, 4)
    let second = get(tokens, 5)
    require variable.kind == "identifier"
    require equal_sign.kind == "operator" and equal_sign.lexeme == "="
    require first.kind == "integer" and second.kind == "integer"
    require first_operator.kind == "operator"
    expressions = append(expressions, ExprNode(kind="integer", lexeme=first.lexeme, operator="", left_id=0, right_id=0, start=first.offset, end=first.end))
    expressions = append(expressions, ExprNode(kind="integer", lexeme=second.lexeme, operator="", left_id=0, right_id=0, start=second.offset, end=second.end))
    if count(tokens) == 5:
        require contains("+-*/", first_operator.lexeme) and text_length(first_operator.lexeme) == 1
        expressions = append(expressions, ExprNode(kind="binary", lexeme="", operator=first_operator.lexeme, left_id=1, right_id=2, start=first.offset, end=second.end))
        expression_assignments = append(expression_assignments, ExpressionAssignment(name=variable.lexeme, expression_id=3, start=variable.offset, end=second.end))
    else:
        let second_operator = get(tokens, 6)
        let third = get(tokens, 7)
        require first_operator.lexeme == "+" or first_operator.lexeme == "-"
        require second_operator.kind == "operator" and (second_operator.lexeme == "*" or second_operator.lexeme == "/")
        require third.kind == "integer"
        expressions = append(expressions, ExprNode(kind="integer", lexeme=third.lexeme, operator="", left_id=0, right_id=0, start=third.offset, end=third.end))
        expressions = append(expressions, ExprNode(kind="binary", lexeme="", operator=second_operator.lexeme, left_id=2, right_id=3, start=second.offset, end=third.end))
        expressions = append(expressions, ExprNode(kind="binary", lexeme="", operator=first_operator.lexeme, left_id=1, right_id=4, start=first.offset, end=third.end))
        expression_assignments = append(expression_assignments, ExpressionAssignment(name=variable.lexeme, expression_id=5, start=variable.offset, end=third.end))


action merge_tokens:
    require cursor == text_length(source) and layout_cursor == text_length(source)
    require count(unified_tokens) == 0
    require count(tokens) + count(layout_tokens) <= 100
    merge_i = 1
    merge_j = 1
    while merge_i <= count(tokens) or merge_j <= count(layout_tokens) limit 100:
        if merge_i > count(tokens):
            let layout = get(layout_tokens, merge_j)
            unified_tokens = append(unified_tokens, UnifiedToken(kind=layout.kind, lexeme="", offset=layout.offset, end=layout.offset, line=layout.line, column=layout.column, level=layout.level))
            merge_j = merge_j + 1
        else:
            if merge_j > count(layout_tokens):
                let normal = get(tokens, merge_i)
                unified_tokens = append(unified_tokens, UnifiedToken(kind=normal.kind, lexeme=normal.lexeme, offset=normal.offset, end=normal.end, line=normal.line, column=normal.column, level=0))
                merge_i = merge_i + 1
            else:
                let next_normal = get(tokens, merge_i)
                let next_layout = get(layout_tokens, merge_j)
                if next_layout.offset <= next_normal.offset:
                    unified_tokens = append(unified_tokens, UnifiedToken(kind=next_layout.kind, lexeme="", offset=next_layout.offset, end=next_layout.offset, line=next_layout.line, column=next_layout.column, level=next_layout.level))
                    merge_j = merge_j + 1
                else:
                    unified_tokens = append(unified_tokens, UnifiedToken(kind=next_normal.kind, lexeme=next_normal.lexeme, offset=next_normal.offset, end=next_normal.end, line=next_normal.line, column=next_normal.column, level=0))
                    merge_i = merge_i + 1


# Consume real A5.1 unified tokens, not the original parallel lexical
# token array. Stable record IDs of unified_tokens are 1..N for one scan.
action parse_program:
    require cursor == text_length(source) and layout_cursor == text_length(source)
    require merge_i == count(tokens) + 1 and merge_j == count(layout_tokens) + 1
    require count(program_assignments) == 0
    require count(unified_tokens) > 0
    parse_cursor = 1
    parse_depth = 0
    while parse_cursor <= count(unified_tokens) limit 100:
        let current = get(unified_tokens, parse_cursor)
        if current.kind == "INDENT":
            require count(program_assignments) > 0
            require current.level == parse_depth + 1
            require parse_depth < 8
            parse_depth = parse_depth + 1
            parse_cursor = parse_cursor + 1
        else:
            if current.kind == "DEDENT":
                require parse_depth > 0
                require current.level == parse_depth - 1
                parse_depth = parse_depth - 1
                parse_cursor = parse_cursor + 1
            else:
                require current.kind == "identifier"
                require parse_cursor + 3 <= count(unified_tokens)
                let eq = get(unified_tokens, parse_cursor + 1)
                let number = get(unified_tokens, parse_cursor + 2)
                let nl = get(unified_tokens, parse_cursor + 3)
                require eq.kind == "operator" and eq.lexeme == "="
                require number.kind == "integer"
                require nl.kind == "NEWLINE"
                require eq.line == current.line
                require number.line == current.line
                require nl.line == current.line
                require current.offset < eq.offset and eq.offset < number.offset
                require number.end <= nl.offset
                program_assignments = append(program_assignments, ProgramAssignment(name=current.lexeme, literal=number.lexeme, depth=parse_depth, line=current.line, start=current.offset, end=number.end))
                parse_cursor = parse_cursor + 4
    require parse_depth == 0



# A separate syntax pass over the real unified stream. First error wins.
# Restricted grammar: top-level action NAME:, nested if true/false:,
# and arithmetic assignments within actions. No else or general conditions.
action validate_blocks:
    require cursor == text_length(source) and layout_cursor == text_length(source)
    require merge_i == count(tokens) + 1 and merge_j == count(layout_tokens) + 1
    require not validation_done
    while validate_i <= count(unified_tokens) and validate_error == "" limit 100:
        let token = get(unified_tokens, validate_i)
        if token.kind == "INDENT":
            if not pending_body:
                validate_error = "unexpected_indent"
            else:
                if token.level != validate_depth + 1:
                    validate_error = "invalid_indent_depth"
                else:
                    validate_depth = token.level
                    pending_body = false
                    validate_i = validate_i + 1
        else:
            if pending_body:
                validate_error = "expected_indented_body"
            else:
                if token.kind == "DEDENT":
                    if validate_depth == 0 or token.level != validate_depth - 1:
                        validate_error = "invalid_dedent"
                    else:
                        validate_depth = token.level
                        validate_i = validate_i + 1
                else:
                    if token.kind != "identifier":
                        validate_error = "expected_statement"
                    else:
                        if token.lexeme == "action" or token.lexeme == "if":
                            if (token.lexeme == "action" and validate_depth != 0) or (token.lexeme == "if" and validate_depth == 0):
                                validate_error = "invalid_header_context"
                            else:
                                if validate_i + 3 > count(unified_tokens):
                                    validate_error = "invalid_header"
                                else:
                                    let subject = get(unified_tokens, validate_i + 1)
                                    let colon = get(unified_tokens, validate_i + 2)
                                    let nl = get(unified_tokens, validate_i + 3)
                                    if subject.kind != "identifier" or colon.kind != "punct" or colon.lexeme != ":" or nl.kind != "NEWLINE" or subject.line != token.line or colon.line != token.line or nl.line != token.line:
                                        validate_error = "invalid_header"
                                    else:
                                        if token.lexeme == "if" and subject.lexeme != "true" and subject.lexeme != "false":
                                            validate_error = "unsupported_condition"
                                        else:
                                            if count(headers) == 16:
                                                validate_error = "header_budget"
                                            else:
                                                headers = append(headers, BlockHeader(kind=token.lexeme, subject=subject.lexeme, depth=validate_depth, line=token.line, start=token.offset, end=colon.end))
                                                pending_body = true
                                                validate_i = validate_i + 4
                        else:
                            if validate_depth == 0:
                                validate_error = "expected_action"
                            else:
                                if token.lexeme == "else" or token.lexeme == "while" or token.lexeme == "let" or token.lexeme == "require":
                                    validate_error = "unsupported_statement"
                                else:
                                    if validate_i + 1 > count(unified_tokens):
                                        validate_error = "expected_assignment"
                                    else:
                                        let eq = get(unified_tokens, validate_i + 1)
                                        if eq.kind != "operator" or eq.lexeme != "=" or eq.line != token.line:
                                            validate_error = "expected_assignment"
                                        else:
                                            if validated_assignments == 16:
                                                validate_error = "assignment_budget"
                                            else:
                                                validated_assignments = validated_assignments + 1
                                                validate_i = validate_i + 2
                                                expr_parens = 0
                                                validate_operand = true
                                                allow_not = true
                                                comparison_seen = false
                                                compare_top = 0
                                                line_end = false
                                                while not line_end and validate_error == "" and validate_i <= count(unified_tokens) limit 100:
                                                    let part = get(unified_tokens, validate_i)
                                                    if part.kind == "NEWLINE":
                                                        if validate_operand:
                                                            validate_error = "expected_operand"
                                                        else:
                                                            if expr_parens != 0:
                                                                validate_error = "unclosed_group"
                                                            else:
                                                                line_end = true
                                                    else:
                                                        if validate_operand:
                                                            if part.kind == "integer" or (part.kind == "identifier" and atom_name(part.lexeme)):
                                                                validate_operand = false
                                                            else:
                                                                if part.kind == "operator" and part.lexeme == "-":
                                                                    allow_not = false
                                                                else:
                                                                    if part.kind == "identifier" and part.lexeme == "not" and allow_not:
                                                                        allow_not = true
                                                                    else:
                                                                        if part.kind == "punct" and part.lexeme == "(":
                                                                            let flag = 1 if comparison_seen else 0
                                                                            compare_depth = append(compare_depth, StackOperator(symbol="(", priority=flag, offset=0, previous=compare_top))
                                                                            compare_top = count(compare_depth)
                                                                            comparison_seen = false
                                                                            allow_not = true
                                                                            expr_parens = expr_parens + 1
                                                                        else:
                                                                            validate_error = "expected_operand"
                                                        else:
                                                            if part.kind == "punct" and part.lexeme == ")":
                                                                if expr_parens == 0:
                                                                    validate_error = "unexpected_close"
                                                                else:
                                                                    expr_parens = expr_parens - 1
                                                                    let level = get(compare_depth, compare_top)
                                                                    comparison_seen = level.priority == 1
                                                                    compare_top = level.previous
                                                            else:
                                                                if (part.kind == "operator" or part.kind == "identifier") and binary_op(part.lexeme):
                                                                    if comparison(part.lexeme):
                                                                        if comparison_seen:
                                                                            validate_error = "chained_comparison"
                                                                        else:
                                                                            comparison_seen = true
                                                                    if part.lexeme == "and" or part.lexeme == "or":
                                                                        comparison_seen = false
                                                                        allow_not = true
                                                                    else:
                                                                        allow_not = false
                                                                    validate_operand = true
                                                                else:
                                                                    validate_error = "expected_operator"
                                                    if validate_error == "":
                                                        validate_i = validate_i + 1
                                                if not line_end and validate_error == "":
                                                    validate_error = "expected_newline"
    if validate_error == "":
        if pending_body:
            validate_error = "expected_indented_body"
        else:
            if count(headers) == 0:
                validate_error = "expected_action"
    if validate_error != "":
        if validate_i <= count(unified_tokens):
            let bad = get(unified_tokens, validate_i)
            diagnostics = append(diagnostics, SyntaxDiagnostic(code=validate_error, line=bad.line, column=bad.column, start=bad.offset, end=bad.end))
        else:
            diagnostics = append(diagnostics, SyntaxDiagnostic(code=validate_error, line=layout_line, column=layout_column, start=text_length(source), end=text_length(source)))
    validation_done = true

# Shunting-yard with immutable linked stack cells, bounded by the token budget.
action parse_expression_program:
    require cursor == text_length(source) and layout_cursor == text_length(source)
    require merge_i == count(tokens) + 1 and merge_j == count(layout_tokens) + 1
    require validation_done and count(diagnostics) == 0
    require count(unified_tokens) > 0
    require count(program_expr_statements) == 0 and count(program_expr_nodes) == 0
    program_expr_cursor = 1
    program_expr_depth = 0
    while program_expr_cursor <= count(unified_tokens) limit 100:
        let token = get(unified_tokens, program_expr_cursor)
        if token.kind == "INDENT":
            require token.level == program_expr_depth + 1 and program_expr_depth < 8
            program_expr_depth = program_expr_depth + 1
            program_expr_cursor = program_expr_cursor + 1
        else:
            if token.kind == "DEDENT":
                require program_expr_depth > 0 and token.level == program_expr_depth - 1
                program_expr_depth = program_expr_depth - 1
                program_expr_cursor = program_expr_cursor + 1
            else:
                if token.lexeme == "action" or token.lexeme == "if":
                    program_expr_cursor = program_expr_cursor + 4
                else:
                    require token.kind == "identifier"
                    require program_expr_cursor + 3 <= count(unified_tokens)
                    let eq = get(unified_tokens, program_expr_cursor + 1)
                    require eq.kind == "operator" and eq.lexeme == "=" and eq.line == token.line
                    program_expr_cursor = program_expr_cursor + 2
                    value_top = 0
                    operator_top = 0
                    value_count = 0
                    expecting_value = true
                    finished = false
                    last_end = eq.end
                    while not finished limit 100:
                        require program_expr_cursor <= count(unified_tokens)
                        let part = get(unified_tokens, program_expr_cursor)
                        require part.line == token.line and part.offset >= last_end
                        if part.kind == "NEWLINE":
                            require not expecting_value
                            while operator_top > 0 limit 100:
                                require value_count >= 1 and operator_top > 0
                                let top_op = get(operator_stack, operator_top)
                                require top_op.symbol != "("
                                let right = get(value_stack, value_top)
                                let rnode = get(program_expr_nodes, right.node_id)
                                if top_op.symbol == "neg" or top_op.symbol == "not":
                                    let unary_op = "-" if top_op.symbol == "neg" else "not"
                                    program_expr_nodes = append(program_expr_nodes, ExprNode(kind="unary", lexeme="", operator=unary_op, left_id=right.node_id, right_id=0, start=top_op.offset, end=rnode.end))
                                    value_stack = append(value_stack, StackValue(node_id=count(program_expr_nodes), previous=right.previous))
                                else:
                                    require value_count >= 2
                                    let left = get(value_stack, right.previous)
                                    let lnode = get(program_expr_nodes, left.node_id)
                                    program_expr_nodes = append(program_expr_nodes, ExprNode(kind="binary", lexeme="", operator=top_op.symbol, left_id=left.node_id, right_id=right.node_id, start=lnode.start, end=rnode.end))
                                    value_stack = append(value_stack, StackValue(node_id=count(program_expr_nodes), previous=left.previous))
                                    value_count = value_count - 1
                                value_top = count(value_stack)
                                operator_top = top_op.previous
                            require value_count == 1
                            let root = get(value_stack, value_top)
                            program_expr_statements = append(program_expr_statements, ProgramExpression(name=token.lexeme, expression_id=root.node_id, depth=program_expr_depth, line=token.line, start=token.offset, end=last_end))
                            finished = true
                        else:
                            if expecting_value:
                                if part.kind == "integer" or (part.kind == "identifier" and atom_name(part.lexeme)):
                                    let leaf_kind = "integer" if part.kind == "integer" else "boolean" if part.lexeme == "true" or part.lexeme == "false" or part.lexeme == "True" or part.lexeme == "False" else "identifier"
                                    program_expr_nodes = append(program_expr_nodes, ExprNode(kind=leaf_kind, lexeme=part.lexeme, operator="", left_id=0, right_id=0, start=part.offset, end=part.end))
                                    value_stack = append(value_stack, StackValue(node_id=count(program_expr_nodes), previous=value_top))
                                    value_top = count(value_stack)
                                    value_count = value_count + 1
                                    expecting_value = false
                                else:
                                    if part.lexeme == "-" or part.lexeme == "not":
                                        let unary_symbol = "neg" if part.lexeme == "-" else "not"
                                        operator_stack = append(operator_stack, StackOperator(symbol=unary_symbol, priority=op_rank(unary_symbol), offset=part.offset, previous=operator_top))
                                        operator_top = count(operator_stack)
                                    else:
                                        require part.kind == "punct" and part.lexeme == "("
                                        operator_stack = append(operator_stack, StackOperator(symbol="(", priority=0, offset=part.offset, previous=operator_top))
                                        operator_top = count(operator_stack)
                            else:
                                if part.kind == "punct" and part.lexeme == ")":
                                    reducing = true
                                    while reducing limit 100:
                                        require operator_top > 0
                                        let candidate = get(operator_stack, operator_top)
                                        if candidate.symbol == "(":
                                            let inner = get(value_stack, value_top)
                                            program_expr_nodes = append(program_expr_nodes, ExprNode(kind="group", lexeme="", operator="", left_id=inner.node_id, right_id=0, start=candidate.offset, end=part.end))
                                            value_stack = append(value_stack, StackValue(node_id=count(program_expr_nodes), previous=inner.previous))
                                            value_top = count(value_stack)
                                            operator_top = candidate.previous
                                            reducing = false
                                        else:
                                            require value_count >= 1 and operator_top > 0
                                            let top_op = get(operator_stack, operator_top)
                                            require top_op.symbol != "("
                                            let right = get(value_stack, value_top)
                                            let rnode = get(program_expr_nodes, right.node_id)
                                            if top_op.symbol == "neg" or top_op.symbol == "not":
                                                let unary_op = "-" if top_op.symbol == "neg" else "not"
                                                program_expr_nodes = append(program_expr_nodes, ExprNode(kind="unary", lexeme="", operator=unary_op, left_id=right.node_id, right_id=0, start=top_op.offset, end=rnode.end))
                                                value_stack = append(value_stack, StackValue(node_id=count(program_expr_nodes), previous=right.previous))
                                            else:
                                                require value_count >= 2
                                                let left = get(value_stack, right.previous)
                                                let lnode = get(program_expr_nodes, left.node_id)
                                                program_expr_nodes = append(program_expr_nodes, ExprNode(kind="binary", lexeme="", operator=top_op.symbol, left_id=left.node_id, right_id=right.node_id, start=lnode.start, end=rnode.end))
                                                value_stack = append(value_stack, StackValue(node_id=count(program_expr_nodes), previous=left.previous))
                                                value_count = value_count - 1
                                            value_top = count(value_stack)
                                            operator_top = top_op.previous
                                else:
                                    require binary_op(part.lexeme)
                                    precedence = op_rank(part.lexeme)
                                    reducing = operator_top > 0
                                    while reducing limit 100:
                                        let candidate = get(operator_stack, operator_top)
                                        if candidate.priority < precedence:
                                            reducing = false
                                        else:
                                            require value_count >= 1 and operator_top > 0
                                            let top_op = get(operator_stack, operator_top)
                                            require top_op.symbol != "("
                                            let right = get(value_stack, value_top)
                                            let rnode = get(program_expr_nodes, right.node_id)
                                            if top_op.symbol == "neg" or top_op.symbol == "not":
                                                let unary_op = "-" if top_op.symbol == "neg" else "not"
                                                program_expr_nodes = append(program_expr_nodes, ExprNode(kind="unary", lexeme="", operator=unary_op, left_id=right.node_id, right_id=0, start=top_op.offset, end=rnode.end))
                                                value_stack = append(value_stack, StackValue(node_id=count(program_expr_nodes), previous=right.previous))
                                            else:
                                                require value_count >= 2
                                                let left = get(value_stack, right.previous)
                                                let lnode = get(program_expr_nodes, left.node_id)
                                                program_expr_nodes = append(program_expr_nodes, ExprNode(kind="binary", lexeme="", operator=top_op.symbol, left_id=left.node_id, right_id=right.node_id, start=lnode.start, end=rnode.end))
                                                value_stack = append(value_stack, StackValue(node_id=count(program_expr_nodes), previous=left.previous))
                                                value_count = value_count - 1
                                            value_top = count(value_stack)
                                            operator_top = top_op.previous
                                            reducing = operator_top > 0
                                    operator_stack = append(operator_stack, StackOperator(symbol=part.lexeme, priority=precedence, offset=part.offset, previous=operator_top))
                                    operator_top = count(operator_stack)
                                    expecting_value = true
                            last_end = part.end
                        program_expr_cursor = program_expr_cursor + 1
    require program_expr_depth == 0

test initially_empty: -> count(tokens) == 0
screen main:
    text "Experimental Sedrava A5.5: bounded compound expression AST."
