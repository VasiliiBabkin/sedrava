# A5.10a — self-hosted bounded stack machine for function IR.
# Separate from A5.9b source lowering; input is explicit textual IR.
app "Sedrava source compiler A5.10b"
record Function:
    name: text
    first: int
    last: int
    argc: int
    locals: int
record Instruction:
    opcode: text
    operand: text
    number: int
record Slot:
    value: int
    initialized: bool
record Frame:
    function_id: int
    return_pc: int
    base: int
record SourceToken:
    kind: text
    word: text
record SourceFunction:
    name: text
    begin: int
    end: int
    argc: int
    param_start: int
record Parameter:
    name: text
record Operator:
    kind: text
    word: text
    rank: int
    argc: int
    function_id: int
fn ascii_digit(c: text) -> bool = contains("0123456789",c)
fn ascii_letter(c: text) -> bool = contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_",c)
fn digit(c: text) -> int = 0 if c == "0" else 1 if c == "1" else 2 if c == "2" else 3 if c == "3" else 4 if c == "4" else 5 if c == "5" else 6 if c == "6" else 7 if c == "7" else 8 if c == "8" else 9
state source = "fn main() -> int = 42"
state functions: list<Function>(max=16) = []
state instructions: list<Instruction>(max=100) = []
state operands: list<Slot>(max=64) = []
state locals: list<Slot>(max=64) = []
state frames: list<Frame>(max=8) = []
state compiled = false
state finished = false
state answer = 0
state pc = 0
state sp = 0
state fp = 0
state steps = 0
state peak_frames = 0
state cursor = 0
state word = ""
state word_count = 0
state word1 = ""
state word2 = ""
state word3 = ""
state word4 = ""
state newline = false
state function_name = ""
state first = 0
state argc = 0
state local_count = 0
state number = 0
state parse_text = ""
state npos = 0
state acc = 0
state nsign = 1
state search = 0
state function_id = 0
state slot = 0
state index = 0
state arg = 0
state lhs = 0
state rhs = 0
state value = 0
state op = ""
state dest = 0
state next_pc = 0
state current_base = 0
state current_func = 0
state returned = 0

state tokens: list<SourceToken>(max=100) = []
state signatures: list<SourceFunction>(max=16) = []
state parameters: list<Parameter>(max=100) = []
state operators: list<Operator>(max=64) = []
state lex_done = false
state signatures_done = false
state token_i = 1
state source_begin = 0
state source_end = 0
state param_start = 0
state top = 0
state expect_value = true
state call_id = 0
state rank = 0
state token_word = ""
state token_kind = ""
state emitted = 0
state lower_function = 1
state emitted_first = 0
state negative = false
state temp_name = ""
state actual_args = 0

action tokenize:
    require not lex_done and not compiled
    require text_length(source) <= 1024
    cursor = 0
    while cursor < text_length(source) limit 256:
        let c = text_at(source,cursor)
        cursor = cursor+1
        if c != " " and c != "\t":
            token_word = c
            token_kind = "punct"
            if c == "\n":
                token_kind = "newline"
            else:
                if ascii_letter(c):
                    token_kind = "name"
                    while cursor < text_length(source) and (ascii_letter(text_at(source,cursor)) or ascii_digit(text_at(source,cursor))) limit 64:
                        token_word = concat(token_word,text_at(source,cursor))
                        cursor = cursor+1
                else:
                    if ascii_digit(c):
                        token_kind = "int"
                        while cursor < text_length(source) and ascii_digit(text_at(source,cursor)) limit 16:
                            token_word = concat(token_word,text_at(source,cursor))
                            cursor = cursor+1
                    else:
                        if c == "-" and cursor < text_length(source) and text_at(source,cursor) == ">":
                            token_word = "->"
                            cursor = cursor+1
                        else:
                            require contains("(),:=+-*",c)
            tokens = append(tokens,SourceToken(kind=token_kind,word=token_word))
    tokens = append(tokens,SourceToken(kind="eof",word=""))
    lex_done = true

action signatures_pass:
    require lex_done and not signatures_done
    token_i = 1
    while get(tokens,token_i).kind != "eof" limit 100:
        if get(tokens,token_i).kind == "newline":
            token_i = token_i+1
        else:
            require get(tokens,token_i).word == "fn"
            token_i = token_i+1
            let name = get(tokens,token_i)
            require name.kind == "name" and text_length(name.word) <= 16 and name.word != "fn" and name.word != "int"
            function_name = name.word
            search = 1
            while search <= count(signatures) limit 16:
                require get(signatures,search).name != function_name
                search = search+1
            token_i = token_i+1
            require get(tokens,token_i).word == "("
            token_i = token_i+1
            argc = 0
            param_start = count(parameters)+1
            if get(tokens,token_i).word != ")":
                newline = false
                while not newline limit 8:
                    let param = get(tokens,token_i)
                    require param.kind == "name" and param.word != "fn" and param.word != "int"
                    search = param_start
                    while search <= count(parameters) limit 8:
                        require get(parameters,search).name != param.word
                        search = search+1
                    require get(tokens,token_i+1).word == ":" and get(tokens,token_i+2).word == "int"
                    parameters = append(parameters,Parameter(name=param.word))
                    argc = argc+1
                    token_i = token_i+3
                    if get(tokens,token_i).word == ")":
                        newline = true
                    else:
                        require get(tokens,token_i).word == ","
                        token_i = token_i+1
            require get(tokens,token_i).word == ")" and get(tokens,token_i+1).word == "->" and get(tokens,token_i+2).word == "int" and get(tokens,token_i+3).word == "="
            token_i = token_i+4
            source_begin = token_i
            while get(tokens,token_i).kind != "newline" and get(tokens,token_i).kind != "eof" limit 100:
                token_i = token_i+1
            require source_begin < token_i
            signatures = append(signatures,SourceFunction(name=function_name,begin=source_begin,end=token_i-1,argc=argc,param_start=param_start))
    require count(signatures) > 0
    signatures_done = true

# Emit postorder stack instructions using an operator stack. Function-call
# markers store arity; every comma closes exactly one argument.
action lower_source:
    require signatures_done and not compiled and count(functions) == 0
    function_id = 0
    lower_function = 1
    while lower_function <= count(signatures) limit 16:
        let sig = get(signatures,lower_function)
        emitted_first = count(instructions)+1
        if sig.name == "main":
            require sig.argc == 0
            function_id = lower_function
        token_i = sig.begin
        top = 0
        expect_value = true
        while token_i <= sig.end limit 100:
            let tok = get(tokens,token_i)
            token_word = tok.word
            if expect_value:
                if tok.kind == "int" or tok.word == "-":
                    negative = tok.word == "-"
                    if negative:
                        token_i = token_i+1
                    let literal = get(tokens,token_i)
                    require token_i <= sig.end and literal.kind == "int"
                    acc = 0
                    npos = 0
                    while npos < text_length(literal.word) limit 16:
                        let v = digit(text_at(literal.word,npos))
                        require acc < 214748364 or (acc == 214748364 and v <= 7)
                        acc = acc*10+v
                        npos = npos+1
                    instructions = append(instructions,Instruction(opcode="const",operand="",number=0-acc if negative else acc))
                    expect_value = false
                else:
                    if tok.kind == "name":
                        if token_i < sig.end and get(tokens,token_i+1).word == "(":
                            call_id = 0
                            search = 1
                            while search <= count(signatures) limit 16:
                                if get(signatures,search).name == tok.word:
                                    call_id = search
                                search = search+1
                            require call_id > 0
                            if token_i+2 <= sig.end and get(tokens,token_i+2).word == ")":
                                require get(signatures,call_id).argc == 0
                                instructions = append(instructions,Instruction(opcode="call",operand=tok.word,number=call_id))
                                token_i = token_i+2
                                expect_value = false
                            else:
                                top = top+1
                                if top > count(operators):
                                    operators = append(operators,Operator(kind="call",word=tok.word,rank=0,argc=1,function_id=call_id))
                                else:
                                    operators = update(operators,top,Operator(kind="call",word=tok.word,rank=0,argc=1,function_id=call_id))
                                token_i = token_i+1
                        else:
                            slot = 0
                            search = 0
                            while search < sig.argc limit 8:
                                if get(parameters,sig.param_start+search).name == tok.word:
                                    slot = search+1
                                search = search+1
                            require slot > 0
                            instructions = append(instructions,Instruction(opcode="load",operand="",number=slot-1))
                            expect_value = false
                    else:
                        require tok.word == "("
                        top = top+1
                        if top > count(operators):
                            operators = append(operators,Operator(kind="group",word="",rank=0,argc=0,function_id=0))
                        else:
                            operators = update(operators,top,Operator(kind="group",word="",rank=0,argc=0,function_id=0))
            else:
                if tok.word == "+" or tok.word == "-" or tok.word == "*":
                    rank = 2 if tok.word == "*" else 1
                    while top > 0 and get(operators,top).rank >= rank limit 64:
                        let prior = get(operators,top)
                        instructions = append(instructions,Instruction(opcode=prior.word,operand="",number=0))
                        top = top-1
                    op = "add" if tok.word == "+" else "sub" if tok.word == "-" else "mul"
                    top = top+1
                    if top > count(operators):
                        operators = append(operators,Operator(kind="binary",word=op,rank=rank,argc=0,function_id=0))
                    else:
                        operators = update(operators,top,Operator(kind="binary",word=op,rank=rank,argc=0,function_id=0))
                    expect_value = true
                else:
                    require tok.word == "," or tok.word == ")"
                    while top > 0 and get(operators,top).rank > 0 limit 64:
                        let prior = get(operators,top)
                        instructions = append(instructions,Instruction(opcode=prior.word,operand="",number=0))
                        top = top-1
                    require top > 0
                    let marker = get(operators,top)
                    if tok.word == ",":
                        require marker.kind == "call" and marker.argc < 8
                        operators = update(operators,top,Operator(kind="call",word=marker.word,rank=0,argc=marker.argc+1,function_id=marker.function_id))
                        expect_value = true
                    else:
                        if marker.kind == "call":
                            require marker.argc == get(signatures,marker.function_id).argc
                            instructions = append(instructions,Instruction(opcode="call",operand=marker.word,number=marker.function_id))
                        else:
                            require marker.kind == "group"
                        top = top-1
            token_i = token_i+1
        require not expect_value
        while top > 0 limit 64:
            let prior = get(operators,top)
            require prior.rank > 0
            instructions = append(instructions,Instruction(opcode=prior.word,operand="",number=0))
            top = top-1
        instructions = append(instructions,Instruction(opcode="return",operand="",number=0))
        functions = append(functions,Function(name=sig.name,first=emitted_first,last=count(instructions),argc=sig.argc,locals=sig.argc))
        lower_function = lower_function+1
    require function_id > 0
    compiled = true

action run_ir:
    require compiled and not finished and fp == 0 and count(frames) == 0
    index = 1
    while index <= 64 limit 64:
        operands = append(operands,Slot(value=0,initialized=false))
        locals = append(locals,Slot(value=0,initialized=false))
        index = index+1
    index = 1
    while index <= 8 limit 8:
        frames = append(frames,Frame(function_id=0,return_pc=0,base=0))
        index = index+1
    fp = 1
    peak_frames = 1
    frames = update(frames,1,Frame(function_id=function_id,return_pc=0,base=0))
    pc = get(functions,function_id).first
    sp = 0
    steps = 0
    while fp > 0 and steps < 256 limit 256:
        let frame = get(frames,fp)
        let f = get(functions,frame.function_id)
        require pc >= f.first and pc <= f.last
        let inst = get(instructions,pc)
        op = inst.opcode
        current_base = frame.base
        next_pc = pc+1
        if op == "const" or op == "load":
            value = inst.number
            if op == "load":
                let local = get(locals,(fp-1)*8+inst.number+1)
                require local.initialized
                value = local.value
            require sp < 64
            sp = sp+1
            operands = update(operands,sp,Slot(value=value,initialized=true))
        else:
            if op == "store":
                require sp > current_base
                value = get(operands,sp).value
                sp = sp-1
                locals = update(locals,(fp-1)*8+inst.number+1,Slot(value=value,initialized=true))
            else:
                if op == "call":
                    let callee = get(functions,inst.number)
                    require fp < 8 and sp-current_base >= callee.argc
                    dest = sp-callee.argc
                    index = 0
                    while index < 8 limit 8:
                        value = 0
                        if index < callee.argc:
                            value = get(operands,dest+index+1).value
                        locals = update(locals,fp*8+index+1,Slot(value=value,initialized=index < callee.argc))
                        index = index+1
                    sp = dest
                    fp = fp+1
                    if fp > peak_frames:
                        peak_frames = fp
                    frames = update(frames,fp,Frame(function_id=inst.number,return_pc=next_pc,base=dest))
                    next_pc = callee.first
                else:
                    if op == "return":
                        require sp == current_base+1
                        returned = get(operands,sp).value
                        fp = fp-1
                        if fp == 0:
                            answer = returned
                        else:
                            next_pc = frame.return_pc
                    else:
                        if op == "jump" or op == "jz":
                            value = 0
                            if op == "jz":
                                require sp > current_base
                                value = get(operands,sp).value
                                sp = sp-1
                            if op == "jump" or value == 0:
                                next_pc = f.first+inst.number-1
                        else:
                            require sp >= current_base+2
                            lhs = get(operands,sp-1).value
                            rhs = get(operands,sp).value
                            value = lhs+rhs if op == "add" else lhs-rhs if op == "sub" else lhs*rhs if op == "mul" else 1 if (op == "eq" and lhs == rhs) or (op == "lt" and lhs < rhs) else 0
                            sp = sp-1
                            operands = update(operands,sp,Slot(value=value,initialized=true))
        pc = next_pc
        steps = steps+1
    require fp == 0
    finished = true

test initial: -> not compiled
screen main:
    text "A5.10b source-to-stack-IR compiler"
