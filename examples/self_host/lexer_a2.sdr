# Experimental Sedrava-written lexer A2, not the Rust compiler lexer.
# One action scans up to 256 Unicode scalars. Strings preserve raw spelling.
# Supports ASCII identifiers/integers, quoted strings and basic escapes,
# whitespace, # comments, punctuation and two-character operators.
app "Self-host Lexer A2"
record Token:
    kind: text
    lexeme: text
    offset: int
fn ascii_letter(ch: text) -> bool = contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_", ch)
fn ascii_digit(ch: text) -> bool = contains("0123456789", ch)

state source = "sum==42 # comment"
state cursor = 0
state start = 0
state fragment = ""
state fragment_kind = ""
state operator = ""
state in_string = false
state escaped = false
state in_comment = false
state tokens: list<Token>(max=100) = []

action scan:
    require text_length(source) <= 256
    while cursor < text_length(source) limit 256:
        let ch = text_at(source, cursor)
        if in_comment:
            if ch == "\n":
                in_comment = false
        else:
            if in_string:
                fragment = concat(fragment, ch)
                if escaped:
                    require contains("ntr\"\\", ch)
                    escaped = false
                else:
                    if ch == "\\":
                        escaped = true
                    else:
                        if ch == "\"":
                            tokens = append(tokens, Token(kind="string", lexeme=fragment, offset=start))
                            fragment = ""
                            fragment_kind = ""
                            in_string = false
            else:
                if ch == "#":
                    if fragment != "":
                        tokens = append(tokens, Token(kind=fragment_kind, lexeme=fragment, offset=start))
                        fragment = ""
                        fragment_kind = ""
                    in_comment = true
                else:
                    if ch == "\"":
                        if fragment != "":
                            tokens = append(tokens, Token(kind=fragment_kind, lexeme=fragment, offset=start))
                            fragment = ""
                            fragment_kind = ""
                        start = cursor
                        fragment = ch
                        fragment_kind = "string"
                        in_string = true
                    else:
                        if contains(" \t\r\n", ch):
                            if fragment != "":
                                tokens = append(tokens, Token(kind=fragment_kind, lexeme=fragment, offset=start))
                                fragment = ""
                                fragment_kind = ""
                        else:
                            if contains("(){}[],:.+-*/=<>!", ch):
                                if fragment != "":
                                    tokens = append(tokens, Token(kind=fragment_kind, lexeme=fragment, offset=start))
                                    fragment = ""
                                    fragment_kind = ""
                                operator = ch
                                if cursor + 1 < text_length(source):
                                    let next_ch = text_at(source, cursor + 1)
                                    if next_ch == "=" and contains("=!<>", ch):
                                        operator = concat(ch, next_ch)
                                        cursor = cursor + 1
                                    else:
                                        if ch == "-" and next_ch == ">":
                                            operator = "->"
                                            cursor = cursor + 1
                                tokens = append(tokens, Token(kind="punct", lexeme=operator, offset=cursor + 1 - text_length(operator)))
                            else:
                                require ascii_letter(ch) or ascii_digit(ch)
                                if fragment == "":
                                    start = cursor
                                    if ascii_digit(ch):
                                        fragment_kind = "integer"
                                    else:
                                        fragment_kind = "identifier"
                                else:
                                    if fragment_kind == "integer":
                                        require ascii_digit(ch)
                                fragment = concat(fragment, ch)
        cursor = cursor + 1
    require not in_string
    require not escaped
    if fragment != "":
        tokens = append(tokens, Token(kind=fragment_kind, lexeme=fragment, offset=start))
        fragment = ""
        fragment_kind = ""
test initially_empty: -> count(tokens) == 0
screen main:
    text "Experimental Sedrava A2 lexer: strings, comments, compound operators."
