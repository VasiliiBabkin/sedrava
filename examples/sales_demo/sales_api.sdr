database-api SalesDemo
route POST "/products":
    query "SELECT id,title,category,price FROM Products ORDER BY id"
route POST "/category":
    param category: text
    require category nonblank
    require category length 1 128
    query "SELECT id,title,price FROM Products WHERE category=? ORDER BY id"
route POST "/categories":
    query "SELECT DISTINCT category FROM Products ORDER BY category"
route POST "/add-product":
    param id: text
    param title: text
    param category: text
    param price: int
    require id key
    require title nonblank
    require title length 1 128
    require category nonblank
    require category length 1 128
    require price range 0 2147483647
    execute "INSERT INTO Products (id,title,category,price) VALUES (?,?,?,?)"
route POST "/add-order":
    param id: text
    param product_id: text
    param amount: int
    require id key
    require product_id key
    require amount range 0 2147483647
    execute "INSERT INTO Orders (id,product_id,amount,paid) VALUES (?,?,?,false)"
route POST "/orders":
    query "SELECT Orders.id,Products.title,Orders.amount,Orders.paid FROM Orders LEFT JOIN Products ON Orders.product_id=Products.id ORDER BY Orders.id"
route POST "/mark-paid":
    param id: text
    require id key
    execute "UPDATE Orders SET paid=true WHERE id=?"
route POST "/paid-summary":
    query "SELECT COUNT(*) AS count_paid,SUM(amount) AS revenue FROM Orders WHERE paid=true"
route POST "/top-products":
    param minimum: int
    require minimum range 0 2147483647
    query "SELECT product_id,SUM(amount) AS total FROM Orders WHERE paid=true GROUP BY product_id HAVING total>=? ORDER BY total DESC"
route POST "/new-product-order":
    param product_id: text
    param title: text
    param category: text
    param price: int
    param order_id: text
    param amount: int
    require product_id key
    require title nonblank
    require title length 1 128
    require category nonblank
    require category length 1 128
    require price range 0 2147483647
    require order_id key
    require amount range 0 2147483647
    transaction [{"sql":"INSERT INTO Products (id,title,category,price) VALUES (?,?,?,?)","using":["product_id","title","category","price"]},{"sql":"INSERT INTO Orders (id,product_id,amount,paid) VALUES (?,?,?,false)","using":["order_id","product_id","amount"]}]
route POST "/correct-order":
    param id: text
    param old_amount: int
    param new_amount: int
    require id key
    require old_amount range 0 2147483647
    require new_amount range 0 2147483647
    sequential [{"sql":"SELECT amount,paid FROM Orders WHERE id=?","using":["id"]},{"sql":"UPDATE Orders SET amount=? WHERE id=? AND amount=? AND paid=false","using":["new_amount","id","old_amount"]},{"sql":"SELECT amount,paid FROM Orders WHERE id=?","using":["id"]}]
route POST "/products-page":
    param after: text
    require after length 0 128
    query "SELECT id,title,category,price FROM Products WHERE id>? ORDER BY id LIMIT 26"
route POST "/orders-page":
    param after: text
    require after length 0 128
    query "SELECT Orders.id,Products.title,Orders.amount,Orders.paid FROM Orders LEFT JOIN Products ON Orders.product_id=Products.id WHERE Orders.id>? ORDER BY Orders.id LIMIT 26"
route POST "/product-count":
    query "SELECT COUNT(*) AS total FROM Products"
route POST "/edit-product":
    param id: text
    param old_title: text
    param old_category: text
    param old_price: int
    param title: text
    param category: text
    param price: int
    require id key
    require old_title length 0 128
    require old_category length 0 128
    require title nonblank
    require title length 1 128
    require category nonblank
    require category length 1 128
    require price range 0 2147483647
    sequential [{"sql":"UPDATE Products SET title=?,category=?,price=? WHERE id=? AND title=? AND category=? AND price=?","using":["title","category","price","id","old_title","old_category","old_price"]}]
route POST "/delete-product":
    param id: text
    param old_title: text
    param old_category: text
    param old_price: int
    require id key
    require old_title length 0 128
    require old_category length 0 128
    sequential [{"sql":"DELETE FROM Products WHERE id=? AND title=? AND category=? AND price=?","using":["id","old_title","old_category","old_price"]}]
route POST "/delete-order":
    param id: text
    param old_amount: int
    require id key
    sequential [{"sql":"DELETE FROM Orders WHERE id=? AND amount=? AND paid=false","using":["id","old_amount"]}]
