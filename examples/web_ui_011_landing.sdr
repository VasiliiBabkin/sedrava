# Experimental Web UI 0.11 Slice A. Build with `sedrava build site`.
# Application code shown in the illustration belongs to the existing 0.10 app mode.
site "Sedrava"
theme:
    background "#10101A"
    surface "#1C1A2B"
    foreground "#F7F4FF"
    accent "#B59BFF"
    gold "#F3D087"

style feature:
    padding 28
    radius 24
    shadow soft

page home at "/":
    title "Sedrava — Describe it. Make it real."
    description "One declarative source. Useful Web and Android applications. Explore the experimental Web UI 0.11."
    navbar label "Primary navigation" padding 16:
        row gap 20 max 1160:
            link "Home" to "/" variant quiet
            link "Components" to "/components/" variant quiet
    container max 1160 padding 24 md-padding 40 id top:
        column gap 64 md-gap 88:
            row justify between gap 24:
                row gap 10:
                    paragraph "◆" color gold size 24
                    paragraph "Sedrava" variant brand
                row gap 24 label "Explore Sedrava":
                    link "The language" to "#language" variant quiet
                    link "GitHub →" to "https://github.com/VasiliiBabkin/sedrava" target blank variant quiet
            grid columns 2 md-columns 1 gap 48 align center:
                column gap 24:
                    paragraph "A language for making things" variant eyebrow
                    heading "Describe it.\nMake it real." variant display
                    paragraph "Your idea deserves more than boilerplate. Describe state, actions and rules — get a useful application." variant lead
                    row gap 12:
                        button "Explore the primitives →" to "/components/"
                        button "View the source →" to "https://github.com/VasiliiBabkin/sedrava" variant secondary
                    paragraph "One source · Web + Android · Offline by design" variant muted size 13
                image "assets/sedrava-blueprint.svg" alt "A Sedrava source file with typed state, a rule and an action, building for Web and Android" radius 20 shadow glow
            column gap 28 id language:
                row justify between align end gap 24:
                    column gap 10:
                        paragraph "Less ceremony. More possibility." variant eyebrow
                        heading "A small language. A clear foundation."
                    link "Read the language reference →" to "https://github.com/VasiliiBabkin/sedrava/blob/main/docs/LANGUAGE_0_10_TEXT.md"
                grid columns 3 gap 20:
                    card style feature:
                        column gap 16:
                            paragraph "01 / STATE" variant eyebrow
                            heading "Describe what matters." size 26
                            paragraph "Typed values, records and bounded collections. Keep the model explicit and the identifiers stable." variant muted
                    card style feature:
                        column gap 16:
                            paragraph "02 / RULES" variant eyebrow
                            heading "Make valid the default." size 26
                            paragraph "Invariants protect the whole action. A rejected change leaves accepted data intact." variant muted
                    card style feature:
                        column gap 16:
                            paragraph "03 / BUILD" variant eyebrow
                            heading "Get the application." size 26
                            paragraph "Generate an offline Web app or native Android project from the same .sdr source." variant muted
            card variant highlight padding 32 md-padding 48 id start:
                column gap 20 max 760:
                    paragraph "The next layer / Experimental 0.11" variant eyebrow
                    heading "Give your ideas a place on the Web."
                    paragraph "This landing page is generated by Sedrava. Compose layouts, typography and safe assets — without writing HTML, CSS or JavaScript." variant lead
                    row gap 16:
                        button "See the component foundation →" to "/components/" background gold
                        link "What is implemented?" to "https://github.com/VasiliiBabkin/sedrava/pull/22" color foreground
            divider
            row justify between gap 16:
                paragraph "Sedrava · Describe the application. Get the application." variant muted size 13
                link "Back to the beginning ↑" to "#top" variant quiet
    footer label "Site footer" padding 20:
        container max 1160:
            paragraph "Sedrava · Experimental Web UI 0.11" variant muted size 13

page components at "/components/":
    title "The foundation — Sedrava Web UI 0.11"
    description "Composable static primitives, accessible defaults and one consistent property model."
    container max 1160 padding 24 md-padding 40:
        column gap 40:
            link "← Sedrava" to "/"
            paragraph "Web UI / Slice A" variant eyebrow
            heading "A small vocabulary.\nA lot of possibility."
            paragraph "These are working primitives. Rich interactions, reusable definitions, forms and documentation search are future slices." variant lead
            callout variant info:
                paragraph "Slice B adds semantic navigation, page footers, notices and escaped code snippets." variant muted
            code "app \"Demo\"\nstate value = 0\npersist value"
            grid columns 3 gap 20:
                card style feature:
                    column gap 16:
                        heading "Structure" size 26
                        paragraph "Page, container, row, column and grid. Nest layouts and adjust spacing at named breakpoints." variant muted
                card style feature:
                    column gap 16:
                        heading "Content" size 26
                        paragraph "Heading, paragraph, card and image. Semantic text and local, validated assets." variant muted
                card style feature:
                    column gap 16:
                        heading "Navigation" size 26
                        paragraph "Link and button-link. Real destinations, keyboard focus and safe URLs — no inert controls." variant muted
            spacer size 8
            divider
            row gap 16:
                button "Return to the landing page" to "/"
                button "View the .sdr example →" to "https://github.com/VasiliiBabkin/sedrava/blob/feature/web-ui-011-slice-a/examples/web_ui_011_landing.sdr" variant secondary
            paragraph "Static-first. No JavaScript runtime. No production website switch." variant muted size 13
